@{
    var technology = ViewBag.TechnologyArticle as System.Text.Json.Nodes.JsonObject;
    var food = ViewBag.FoodArticle as System.Text.Json.Nodes.JsonObject;
    var sport = ViewBag.SportArticle as System.Text.Json.Nodes.JsonObject;
    var technologyDate = technology?["createdDate"]?.GetValue<DateTime>();
}
<div class="col-lg-6 back-hero-right">
    <div class="row back-pl-6">
        <div class="col-lg-12">
            <ul>
                <li>
                    <div class="image-area">
                        <a href="#"><img src="@(technology?["coverImageUrl"]?.GetValue<string>())"
                            alt="@(technology?["title"]?.GetValue<string>())" style="width: 100%; height:300px; object-fit: cover;" /></a>
                        <div class="back-btm-content">
                            <a href="#" class="back-cate back-poli">@(technology?["categoryName"]?.GetValue<string>())</a>
                            <h3><a href="#">@(technology?["title"]?.GetValue<string>())</a></h3>
                            <ul class="technology-card-meta">
                                <li class="back-author"><span><img src="~/userimages/man1.png"
                                        alt="Yazar profil fotoğrafı"
                                        style="width: 30px; height: 30px; object-fit: cover; border-radius: 50%;" /></span><a
                                    href="#">Yazar: Jon Deo</a></li>
                            <li class="back-date"><span><svg xmlns="http://www.w3.org/2000/svg" width="24"
                                    height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    class="feather feather-clock">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg></span>@(technologyDate?.ToString("d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")))</li>
                        <li class="back-comments"><span><svg xmlns="http://www.w3.org/2000/svg" width="24"
                                height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="feather feather-message-square">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z">
                                </path>
                            </svg></span>99 Yorum</li>
                </ul>
            </div>
        </div>
    </li>
</ul>
</div>
<div class="col-lg-6">
    <ul class="back-pr-3">
        <li>
            <div class="image-area">
                <a href="#"><img src="@(food?["coverImageUrl"]?.GetValue<string>())"
                    alt="@(food?["title"]?.GetValue<string>())"
                    style="width: 100%; aspect-ratio: 1 / 1; object-fit: cover;" /></a>
                <div class="back-btm-content">
                    <a href="#" class="back-cate back-tech">@(food?["categoryName"]?.GetValue<string>())</a>
                    <h3><a href="#">@(food?["title"]?.GetValue<string>())</a></h3>
                    <ul>
                        <li class="back-author"><span><img src="~/userimages/man1.png"
                                alt="Yazar profil fotoğrafı"
                                style="width: 20px; height: 20px; object-fit: cover; border-radius: 50%;" /></span><a
                            href="#">Yazar: Jon Deo</a></li>
                </ul>
            </div>
        </div>
    </li>
</ul>
</div>
<div class="col-lg-6">
    <ul class="back-pl-3">
        <li>
            <div class="image-area">
                <a href="#"><img src="@(sport?["coverImageUrl"]?.GetValue<string>())"
                    alt="@(sport?["title"]?.GetValue<string>())"
                    style="width: 100%; aspect-ratio: 1 / 1; object-fit: cover;" /></a>
                <div class="back-btm-content">
                    <a href="#" class="back-cate back-tra">@(sport?["categoryName"]?.GetValue<string>())</a>
                    <h3><a href="#">@(sport?["title"]?.GetValue<string>())</a></h3>
                    <ul>
                        <li class="back-author"><span><img src="~/userimages/man1.png"
                                alt="Yazar profil fotoğrafı"
                                style="width: 20px; height: 20px; object-fit: cover; border-radius: 50%;" /></span><a
                            href="#">Yazar: Jon Deo</a></li>
                </ul>
            </div>
        </div>
    </li>
</ul>
</div>
</div>
</div>
