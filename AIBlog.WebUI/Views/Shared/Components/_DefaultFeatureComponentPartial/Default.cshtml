@model System.Text.Json.Nodes.JsonObject
<div class="col-lg-6 back-hero-right">
    <div class="row back-pl-6">
        <div class="col-lg-12">
            <ul>
                <li>
                    <div class="image-area">
                        <a href="#"><img src="@(Model["coverImageUrl"]?.GetValue<string>())"
                            alt="@(Model["title"]?.GetValue<string>())" style="width: 100%; height:300px; object-fit: cover;" /></a>
                        <div class="back-btm-content">
                            <a href="#" class="back-cate back-poli">@(Model["categoryName"]?.GetValue<string>())</a>
                            <h3><a href="#">@(Model["title"]?.GetValue<string>())</a></h3>
                            <ul>
                                <li class="back-author"><span><img src="~/userimages/man1.png"
                                        alt="Yazar profil fotoğrafı"
                                        style="width: 20px; height: 20px; object-fit: cover; border-radius: 50%;" /></span><a
                                    href="#">Yazar: Jon Deo</a></li>
                            <li class="back-date"><span><svg xmlns="http://www.w3.org/2000/svg" width="24"
                                    height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                    class="feather feather-clock">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg></span>29 Mart 2022</li>
                        <li class="back-comments"><span><svg xmlns="http://www.w3.org/2000/svg" width="24"
                                height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="feather feather-message-square">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z">
                                </path>
                            </svg></span>99 Yorum</li>
                </ul>
            </div>
        </div>
    </li>
</ul>
</div>
<div class="col-lg-6">
    <ul class="back-pr-3">
        <li>
            <div class="image-area">
                <a href="#"><img src="~/articleimages/05.jpg"
                    alt="Dijital ortamda banka binası ve finans grafikleri"
                    style="width: 100%; aspect-ratio: 1 / 1; object-fit: cover;" /></a>
                <div class="back-btm-content">
                    <a href="#" class="back-cate back-tech">Ekonomi</a>
                    <h3><a href="#">Bankacılıkta dijital dönüşüm</a></h3>
                    <ul>
                        <li class="back-author"><span><img src="~/userimages/man1.png"
                                alt="Yazar profil fotoğrafı"
                                style="width: 20px; height: 20px; object-fit: cover; border-radius: 50%;" /></span><a
                            href="#">Yazar: Jon Deo</a></li>
                </ul>
            </div>
        </div>
    </li>
</ul>
</div>
<div class="col-lg-6">
    <ul class="back-pl-3">
        <li>
            <div class="image-area">
                <a href="#"><img src="~/articleimages/03.jpg"
                    alt="Spor salonunda tablet üzerinden antrenman planlayan iki kişi"
                    style="width: 100%; aspect-ratio: 1 / 1; object-fit: cover;" /></a>
                <div class="back-btm-content">
                    <a href="#" class="back-cate back-tra">Spor</a>
                    <h3><a href="#">Antrenmanınızı planlayın</a></h3>
                    <ul>
                        <li class="back-author"><span><img src="~/userimages/man1.png"
                                alt="Yazar profil fotoğrafı"
                                style="width: 20px; height: 20px; object-fit: cover; border-radius: 50%;" /></span><a
                            href="#">Yazar: Jon Deo</a></li>
                </ul>
            </div>
        </div>
    </li>
</ul>
</div>
</div>
</div>