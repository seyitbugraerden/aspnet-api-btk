@using AIBlog.WebUI.Controllers
@using AIBlog.WebUI.Dtos.ResultHomeLastArticle
@model List<ResultArticleLatestVideoDto>

    @{
        var firstArticle = Model.FirstOrDefault();
        var otherArticles = Model.Skip(1).ToList();
    }

    <div class="back-trading-video">
        <div class="container">
            <div class="back-title">
                <h2>Öne Çıkan Videolar</h2>
            </div>
            <div class="row">
                <div class="col-lg-8">
                    <ul>
                        @if(firstArticle != null){
                            <li>
                                <div class="image-area">
                                    <a href="#"><img src="@Url.Content(firstArticle.CoverImageUrl)" alt="@firstArticle.Title" style="width: 100%; aspect-ratio: 1200 / 675; object-fit: cover;"></a>
                                    <a href="@Url.Content(firstArticle.MainVideoUrl)" class="popup-videos back-video" aria-label="Videoyu oynat"><i
                                        class="fa-solid fa-play"></i></a>
                                <div class="back-btm-content">
                                    <h3><a href="#">@firstArticle.Title</a></h3>
                                    <ul>
                                        <li class="back-author"><span><img src="@Url.Content(firstArticle.ImageUrl)" alt="Yazar profil fotoğrafı" style="width: 20px; height: 20px; object-fit: cover; border-radius: 50%;"></span><a href="#">Yazar: @firstArticle.Name @firstArticle.Surname</a></li>
                                        <li class="back-date"><span><svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                class="feather feather-clock">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <polyline points="12 6 12 12 16 14"></polyline>
                                            </svg></span>@firstArticle.CreatedDate.ToString(format:"d MMMM yyy", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</li>
                                </ul>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
        <div class="col-lg-4 pl-30 md-pt-40">
            <ul class="back-hero-bottom">
                @foreach(ResultArticleLatestVideoDto article in otherArticles){
                    <li>
                        <div class="image-areas">
                            <a href="#"><img src="@Url.Content(article.CoverImageUrl)" alt="Haritayla şehir gezen iki kişi" style="width: 100%; aspect-ratio: 200 / 200; object-fit: cover;"></a>
                            <a href="@Url.Content(article.MainVideoUrl)" class="popup-videos back-video" aria-label="Videoyu oynat"><i
                                class="fa-solid fa-play"></i></a>
                    </div>
                    <div class="back-btm-content">
                        <a href="#" class="back-cates">@article.CategoryName</a>
                        <h3><a href="#">@article.Title</a></h3>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>
</div>
</div>