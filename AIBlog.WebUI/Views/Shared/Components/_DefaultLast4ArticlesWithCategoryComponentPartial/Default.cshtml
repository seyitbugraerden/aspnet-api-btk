@using AIBlog.WebUI.Dtos.ResultHomeLastArticle
@model List<ResultHomeLastArticle>

    <div class="col-lg-4 md-mt-40">
        <ul class="back-hero-bottom">
            @foreach (var article in Model){
                <li>
                    <div class="image-areas">
                        <a href="#"><img src="@Url.Content(article.CoverImageUrl)" alt="@article.Title" style="width: 100%; aspect-ratio: 300 / 300; object-fit: cover;"></a>
                    </div>
                    <div class="back-btm-content">
                        <a href="#" class="back-cates">@article.CategoryName
                        </a>
                        <h3><a href="#">@article.Title</a></h3>
                    </div>
                </li>}
            </ul>
        </div>