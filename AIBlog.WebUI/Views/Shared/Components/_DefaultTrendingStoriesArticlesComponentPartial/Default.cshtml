@model List<ResultArticleDto>
    <div class="back-trending-stories">
        <div class="container">
            <div class="back-title">
                <h2>Öne Çıkan Yazılar</h2>
            </div>
            <ul class="back-trending-slider owl-carousel">
                @foreach(ResultArticleDto item in Model){
                    <li>
                        <div class="image-areas">
                            <a href="#"><img src="@Url.Content(item.CoverImageUrl)" alt="@item.Title" style="width: 100%; aspect-ratio: 600 / 600; object-fit: cover;"></a>
                            <a href="#" class="back-cate back-beauty">@item.CategoryName</a>
                        </div>
                        <div class="back-btm-content">
                            <h3><a href="#">@item.Title</a></h3>
                            <ul style="display: flex;flex-direction:column;">
                                <li class="back-author">Yazar: <a href="#">@item.Name @item.Surname</a></li>
                                <li class="back-date"><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-clock"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></span>@item.CreatedDate.ToString("d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</li>
                            </ul>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>