@model List<AIBlog.WebUI.Dtos.CommentDtos.ResultCommentDto>
<div class="author-comment" id="comments">
    <div class="back-title back-small-title"><h2>@Model.Count Yorum</h2></div>
    @if (ViewBag.CommentError is string error)
    {
        <p role="alert">@error</p>
    }
    else if (Model.Count == 0)
    {
        <p>Bu makaleye henüz yorum yapılmamış.</p>
    }
    else
    {
        <ul>
            @foreach (var comment in Model)
            {
                <li><div class="row">
                    <div class="col-lg-1">
                        @if (!string.IsNullOrWhiteSpace(comment.AuthorImageUrl))
                        {
                            <div class="image-comments"><img src="@Url.Content(comment.AuthorImageUrl)" alt="@comment.AuthorName" loading="lazy" /></div>
                        }
                    </div>
                    <div class="col-lg-11"><div class="dsc-comments">
                        <h6>@comment.AuthorName</h6>
                        <span class="reply"><span class="date">@comment.CommentDate.ToString("dd MMMM yyyy HH:mm", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</span></span>
                        <p style="white-space: pre-wrap;">@comment.CommentDetail</p>
                    </div></div>
                </div></li>
            }
        </ul>
    }
</div>
