@model AIBlog.WebUI.Dtos.CommentDtos.CreateCommentDto
@if (Model.ArticleId > 0)
{
    <div class="back-blog-form"><div id="blog-form" class="blog-form">
        <div class="back-title back-small-title"><h2>Yorum Yap</h2></div>
        @if (TempData["CommentSuccess"] is string success)
        {
            <p role="status">@success</p>
        }
        @if (TempData["CommentError"] is string error)
        {
            <p role="alert">@error</p>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Article" asp-action="AddComment" method="post" asp-antiforgery="false">
                <input asp-for="ArticleId" type="hidden" />
                <div class="back-textarea">
                    <label asp-for="CommentDetail">Yorumunuz</label>
                    <textarea asp-for="CommentDetail" placeholder="Mesajınız" required maxlength="4000"></textarea>
                </div>
                <button type="submit" class="back-btn">Yorumu Gönder</button>
            </form>
        }
        else
        {
            <p>Yorum yapmak için oturum açmalısınız.</p>
        }
    </div></div>
}
