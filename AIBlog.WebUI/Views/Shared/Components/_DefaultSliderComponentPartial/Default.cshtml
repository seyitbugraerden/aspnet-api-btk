@model List<ResultHomeArticleDto>
<div class="col-lg-6">
    <ul class="back-hero-slider owl-carousel">
        @foreach (ResultHomeArticleDto article in Model)
        {
            <li>
                <div class="image-area">
                    <img src="@Url.Content(article.CoverImageUrl)" alt="@article.Title"
                         style="aspect-ratio: 1/1; object-fit: cover; width: 100%; height: 100%;">

                    <div class="back-btm-content">
                        <span class="back-cate back-life">
                            @article.CategoryName
                        </span>

                        <h3 style="color:white">@article.Title</h3>

                        <span>
                            @article.CreatedDate.ToString("dd.MM.yyyy")
                        </span>
                    </div>
                </div>
            </li>
        }
    </ul>
</div>