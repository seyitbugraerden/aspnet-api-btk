@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Hata.</h1>
<h2 class="text-danger">İsteğiniz işlenirken bir hata oluştu.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek Kimliği:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Geliştirme Modu</h3>
<p>
    <strong>Development</strong> ortamına geçildiğinde oluşan hata hakkında daha ayrıntılı bilgi gösterilir.
</p>
<p>
    <strong>Yayındaki uygulamalarda geliştirme ortamı etkinleştirilmemelidir.</strong>
    Bu durum, hata ayrıntılarındaki hassas bilgilerin son kullanıcılara gösterilmesine neden olabilir.
    Yerel hata ayıklama için <strong>ASPNETCORE_ENVIRONMENT</strong> ortam değişkenini <strong>Development</strong>
    olarak ayarlayın
    ve uygulamayı yeniden başlatın.
</p>
