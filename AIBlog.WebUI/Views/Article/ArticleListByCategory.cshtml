@{
    ViewData["Title"] = "Kategoriye Göre Yazılar";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="back-wrapper">
    <!--================= Back Breadcrumbs Section Start Here =================-->
    @await Component.InvokeAsync("_BlogDetailBreadcrumbComponentPartial")
    <!--================= Back Breadcrumbs Section End Here =================-->

    <!--================= Blog Section Start Here =================-->
    <div class="back__blog__area back-blog-page back-blog-page-single pt-70 pb-60">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="blog-single-inner">
                        <div class="blog-content">
                            @await Component.InvokeAsync("_BlogDetailContentComponentPartial")

                            @await Component.InvokeAsync("_BlogDetailTagComponentPartial")

                            @await Component.InvokeAsync("_BlogDetailAuthorComponentArtial")
                            @await Component.InvokeAsync("_BlogDetailPreviousAndNextPostComponentPartial")
                            @await Component.InvokeAsync("_BlogDetailRelatedPostComponentPartial")
                            @await Component.InvokeAsync("_BlogDetailCommentComponentArtial")
                            @await Component.InvokeAsync("_BlogDetailAddCommentComponentArtial")
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="back-sidebar pl-30 md-pl-0 back-hero-area back-latest-posts back-whats-posts">

                        @await Component.InvokeAsync("_BlogDetailSearchAreComponentPartial")

                        @await Component.InvokeAsync("_BlogDetailSocialMediaComponentPartial")
                        @await Component.InvokeAsync("_BlogDetailLatestPostComponentPartial")
                        
                        <ul class="back-instragram">
                            <li><a href="#"> <img src="~/images/travel1.jpeg" alt="Görsel"> <i
                                class="fa-brands fa-instagram"></i></a></li>
                                <li><a href="#"> <img src="~/images/roma.jpg" alt="Görsel"> <i
                                    class="fa-brands fa-instagram"></i></a></li>
                                    <li><a href="#"> <img src="~/images/castle1.jpg" alt="Görsel"> <i
                                        class="fa-brands fa-instagram"></i></a></li>
                                        <li><a href="#"> <img src="~/images/festival1.jpg" alt="Görsel"> <i
                                            class="fa-brands fa-instagram"></i></a></li>
                                            <li><a href="#"> <img src="~/images/roma2.jpg" alt="Görsel"> <i
                                                class="fa-brands fa-instagram"></i></a></li>
                                                <li><a href="#"> <img src="~/images/castle2.jpg" alt="Görsel"> <i
                                                    class="fa-brands fa-instagram"></i></a></li>
                                                </ul>

                                                <div class="back-title back-small-title pt-50">
                                                    <h2>Yorumlar</h2>
                                                </div>
                                                <div class="widget back-recent-comments">
                                                    <ul class="recent-comments">
                                                        <li>
                                                            <span class="post-images"><img src="~/userimages/woman1.jpg"
                                                                                               alt="Yorum yapan kişinin fotoğrafı"></span>
                                                                <div class="titles">
                                                                    <h4>John Doe</h4>
                                                                    <span>14 Ocak 2022</span>
                                                                    <p>Yazının daha fazla örnek içermesi faydalı olurdu…</p>
                                                                </div>
                                                            </li>
                                                            <li>
                                                                <span class="post-images"><img src="~/userimages/woman3.jpg"
                                                                                                   alt="Yorum yapan kişinin fotoğrafı"></span>
                                                                    <div class="titles">
                                                                        <h4>Chauffina Carr</h4>
                                                                        <span>10 Nisan 2022</span>
                                                                        <p>Bu yöntemleri sık sık kullanıyoruz. Çok faydalı!</p>
                                                                    </div>
                                                                </li>
                                                                <li>
                                                                    <span class="post-images"><img src="~/userimages/woman5.jpg"
                                                                                                       alt="Yorum yapan kişinin fotoğrafı"></span>
                                                                        <div class="titles">
                                                                            <h4>Jim Séchen</h4>
                                                                            <span>16 Temmuz 2022</span>
                                                                            <p>Yorum yapan herkese teşekkürler!</p>
                                                                        </div>
                                                                    </li>
                                                                </ul>
                                                            </div>

                                                            <div class="back-title back-small-title pt-50">
                                                                <h2>Etiketler</h2>
                                                            </div>
                                                            <div class="widget widget-tags">
                                                                <ul class="tags">
                                                                    <li><a href="#">Eğitim</a></li>
                                                                    <li><a href="#">SEO Pazarlaması</a></li>
                                                                    <li><a href="#">İş Dünyası</a></li>
                                                                    <li><a href="#">Çözümler</a></li>
                                                                    <li><a href="#">Kullanıcı Deneyimi</a></li>
                                                                    <li><a href="#">Vaka İncelemesi</a></li>
                                                                    <li><a href="#">Yaratıcılık</a></li>
                                                                    <li><a href="#">İçgörüler</a></li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!--================= Blog Section End Here =================-->

                                    </div>
