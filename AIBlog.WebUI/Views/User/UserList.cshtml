@model List<AIBlog.WebUI.Dtos.UserDtos.ResultUserDto>
@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "~/Views/UILayout/AdminLayout/Index.cshtml";
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Kullanıcılar</h1>
    <a asp-action="CreateUser" class="btn btn-primary">Yeni Kullanıcı</a>
</div>
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (ViewBag.ErrorMessage is string loadError)
{
    <div class="alert alert-danger" role="alert">@loadError <a asp-action="UserList">Tekrar dene</a></div>
}
else
{
    <div class="card"><div class="card-body table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">Kullanıcı Adı</th><th scope="col">Ad Soyad</th><th scope="col">E-posta</th><th scope="col">Makaleler</th><th scope="col">İşlemler</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center">Henüz kullanıcı yok.</td></tr>
                }
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserName</td><td>@user.Name @user.Surname</td><td>@user.Email</td>
                        <td>
                            <details>
                                <summary>@user.Articles.Count makale</summary>
                                @foreach (var article in user.Articles)
                                {
                                    <div><a asp-controller="AdminArticle" asp-action="UpdateArticle" asp-route-id="@article.ArticleId">@article.Title</a></div>
                                }
                            </details>
                        </td>
                        <td><div class="d-flex gap-2">
                            <a asp-action="UpdateUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" asp-antiforgery="false" onsubmit="return confirm('Kullanıcı silinecek. Makaleleri korunacak ve yazar bağlantıları kaldırılacak. Devam edilsin mi?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}
