@{
    Layout = null;
}

<!doctype html>
<html lang="en" class="minimal-theme">

    @await Component.InvokeAsync("_AdminHeadComponentPartial")

    <body>

        <!--start wrapper-->
        <div class="wrapper">
            <!--start top header-->
            @await Component.InvokeAsync("_AdminNavbarComponentPartial")
            <!--end top header-->

            <!--start sidebar -->
            @await Component.InvokeAsync("_AdminSidebarComponentPartial")
            <!--end sidebar -->

            <!--start content-->
            <main class="page-content">
                @RenderBody()
            </main>
            <!--end page main-->

            <!--start overlay-->
            <div class="overlay nav-toggle-icon"></div>
            <!--end overlay-->

            <!--Start Back To Top Button-->
            <a href="javaScript:;" class="back-to-top"><i class='bx bxs-up-arrow-alt'></i></a>
            <!--End Back To Top Button-->

            @await Component.InvokeAsync("_AdminSwitcherComponentPartial")

        </div>
        <!--end wrapper-->

        <!-- Bootstrap bundle JS -->
        <script src="~/admin/assets/js/bootstrap.bundle.min.js"></script>
        <!--plugins-->
        <script src="~/admin/assets/js/jquery.min.js"></script>
        <script src="~/admin/assets/plugins/simplebar/js/simplebar.min.js"></script>
        <script src="~/admin/assets/plugins/perfect-scrollbar/js/perfect-scrollbar.js"></script>
        <script src="~/admin/assets/js/pace.min.js"></script>
        <!--app-->
        <script src="~/admin/assets/js/app.js"></script>

        @await RenderSectionAsync("Scripts", required: false)

    </body>

</html>
